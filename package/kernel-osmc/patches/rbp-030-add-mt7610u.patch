+static u32 andes_queue_len(struct MCU_CTRL *ctl, DL_LIST *list)
+{
+	u32 qlen;
+	unsigned long flags;
+	NDIS_SPIN_LOCK *lock;
+	
+	lock = andes_get_spin_lock(ctl, list);
