+		pAntenna->field.RfIcType = RFIC_2820;
+		pAntenna->field.TxPath = 1;
+		pAntenna->field.RxPath = 2;
+	}
+	DBGPRINT(RT_DEBUG_WARN, ("E2PROM error, hard code as 0x%04x\n", pAntenna->word));	
+}
