+	ATEExParam.AvgRssi2X8 = OS_HTONS(pATEInfo->AvgRssi2X8);
+
+	Len = sizeof(ATEExParam);
+	NdisMoveMemory(pRaCfg->data, &ATEExParam, Len);
+
+	ResponseToGUI(pRaCfg, wrq, sizeof(pRaCfg->status) + Len, NDIS_STATUS_SUCCESS);
+	
+	return Status;
+}
