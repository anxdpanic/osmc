+#define DFS_EVENT_SIZE						6    /* Number of bytes of each DFS event */
+#endif
+#define DFS_EVENT_BUFFER_SIZE				384  /* Number of bytes of a DFS event buffer */
+#define DFS_SW_RADAR_CHECK_LOOP				50
+#define DFS_SW_RADAR_SHIFT          		3
