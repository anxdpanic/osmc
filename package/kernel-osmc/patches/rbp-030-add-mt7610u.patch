+        	return -ENETDOWN;   
+    	}
+
+	RTMP_STA_IoctlHandle(pAd, NULL, CMD_RTPRIV_IOCTL_STA_SIOCGIWRTS, 0,
+						&RtsThreshold, 0, RT_DEV_PRIV_FLAGS_GET(dev));
+	rts->value = RtsThreshold;
+	rts->disabled = (rts->value == MAX_RTS_THRESHOLD);
+	rts->fixed = 1;
+
+	return 0;
+}
