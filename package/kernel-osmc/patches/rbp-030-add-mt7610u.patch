+VOID RtmpOsSemaWakeUp(RTMP_OS_SEM *pSemOrg)
+{
+	OS_SEM *pSem;
+
+	pSem = (OS_SEM *) (pSemOrg->pContent);
+	if (pSem != NULL)
+		OS_SEM_EVENT_UP(pSem);
+}
