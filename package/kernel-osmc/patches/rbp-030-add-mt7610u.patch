+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+int bin2h(char *infname, char *outfname, char *fw_name)
+{
+	int ret = 0;
+    FILE *infile, *outfile;	
+    unsigned char c;
+    int i=0;
+
+    infile = fopen(infname,"r");
+
+    if (infile == (FILE *) NULL) {
+		printf("Can't read file %s \n",infname);
+		return -1;
+    }
+
+    outfile = fopen(outfname,"w");
