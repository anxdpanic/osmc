+	UINT32		SNR0:8;
+	
+	UINT32		rsv3;
+
+}	RXWI_OMAC, *PRXWI_OMAC;
+#else
+typedef	struct GNU_PACKED _RXWI_OMAC{
+	/* Word	0 */
+	UINT32		wcid:8;
+	UINT32		key_idx:2;
+	UINT32		bss_idx:3;
+	UINT32		UDF:3;
+	UINT32		MPDUtotalByteCnt:12;
