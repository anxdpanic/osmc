+#ifdef STREAM_MODE_SUPPORT
+// StreamModeRegVal - return MAC reg value for StreamMode setting
+UINT32 StreamModeRegVal(
+	IN RTMP_ADAPTER *pAd)
+{
+	UINT32 streamWord;
+
+	switch (pAd->CommonCfg.StreamMode)
+	{
+		case 1:
+			streamWord = 0x030000;
+			break;
+		case 2:
+			streamWord = 0x0c0000;
+			break;
+		case 3:
+			streamWord = 0x0f0000;
+			break;
+		default:
+			streamWord = 0x0;
+			break;
+	}
+
+	return streamWord;
+}
