+#define RTMP_CHIP_ASIC_AGC_ADJUST(__pAd, __Rssi, __R66)	\
+do {	\
+		if (__pAd->chipOps.ChipAGCAdjust != NULL)	\
+			__R66 = __pAd->chipOps.ChipAGCAdjust(__pAd, __Rssi, __R66);	\
+} while (0)
