+static void andes_rf_random_read_callback(struct cmd_msg *msg, char *rsp_payload, u16 rsp_payload_len)
+{
+	u32 i;
+	BANK_RF_REG_PAIR *reg_pair = (BANK_RF_REG_PAIR *)msg->rsp_payload;
+			
+	for (i = 0; i < msg->rsp_payload_len / 8; i++) {
