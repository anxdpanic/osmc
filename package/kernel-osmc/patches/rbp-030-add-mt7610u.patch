+
+static VOID ATE_BBPWrite(
+		IN	PRTMP_ADAPTER	pAd,
+		IN	UCHAR			offset,
+		IN  UCHAR			value)
+{
+	if (ATE_ON(pAd))
+	{
+		ATE_BBP_IO_WRITE8_BY_REG_ID(pAd, offset, value);
+	}
+	else
+	{
+		RTMP_BBP_IO_WRITE8_BY_REG_ID(pAd, offset, value);
+	}
+}
