+				pFreq ++;
+			}
+		}
+			break;
+
+#ifdef EXT_BUILD_CHANNEL_LIST
+       case CMD_RTPRIV_SET_PRECONFIG_VALUE:
+       /* Set some preconfigured value before interface up*/
+           pAd->CommonCfg.DfsType = MAX_RD_REGION;
+           break;
+#endif /* EXT_BUILD_CHANNEL_LIST */
+
+
+#ifdef RTMP_USB_SUPPORT
