+	}
+
+#ifdef QOS_DLS_SUPPORT
+	/*DLSCapable*/
+	if(RTMPGetKeyParameter("DLSCapable", tmpbuf, 32, buffer, TRUE))
+	{
+		if(simple_strtol(tmpbuf, 0, 10) != 0)  /*Enable*/
+		{
+			pAd->CommonCfg.bDLSCapable = TRUE;
+		}
+		else /*Disable*/
