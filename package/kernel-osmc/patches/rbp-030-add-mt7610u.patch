+	UCHAR Register;
+	UINT32 BwBand; /* (BW_20, BW_40, BW_80) | (G_Band, A_Band_LB, A_Band_MB, A_Band_HB) */
+	UCHAR Value;
+} MT76x0_RF_SWITCH_ITEM, *PMT76x0_RF_SWITCH_ITEM;
+
+typedef struct _MT76x0_BBP_Table {
