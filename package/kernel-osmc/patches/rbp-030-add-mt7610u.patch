+
+#define NAF_TYPE_CSO	1<<0
+#define NAF_TYPE_TSO	1<<1
+#define RTMP_GET_PKT_NAF_TYPE(_p)	((RTPKT_TO_OSPKT(_p)->cb[CB_OFF+31]) & (NAF_TYPE_CSO | NAF_TYPE_TSO))
