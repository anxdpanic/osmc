+	*pHtCapabilityLen = 0;
+
+    Ptr = (PCHAR)Fr->Octet;
+
+	/* offset to destination MAC address (Category and Action field)*/
+    Ptr += 2;
+
+	/* get status code from payload and advance the pointer*/
+	if (pStatus)
+		NdisMoveMemory(pStatus, Ptr, 2);
