index 0000000..2b6aa12
--- /dev/null
+++ b/drivers/net/wireless/mt7610u/include/rtmp_timer.h
@@ -0,0 +1,157 @@
+/*
+ *************************************************************************
+ * Ralink Tech Inc.
+ * 5F., No.36, Taiyuan St., Jhubei City,
+ * Hsinchu County 302,
+ * Taiwan, R.O.C.
+ *
