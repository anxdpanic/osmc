+/* IRQL = DISPATCH_LEVEL*/
+VOID MlmeSetPsmBit(
+	IN PRTMP_ADAPTER pAd, 
+	IN USHORT psm)
+{
+
+	pAd->StaCfg.Psm = psm;	  
