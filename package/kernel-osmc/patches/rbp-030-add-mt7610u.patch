+INT set_eFuseGetFreeBlockCount_Proc(  
+   	IN	PRTMP_ADAPTER	pAd,
+	IN	PSTRING			arg)
+{
+	UINT efusefreenum=0;
+	if (pAd->bUseEfuse == FALSE && pAd->bFroceEEPROMBuffer == FALSE)
+		return FALSE;
+	eFuseGetFreeBlockCount(pAd,&efusefreenum);
+	printk("efuseFreeNumber is %d\n",efusefreenum);
+	return TRUE;
+}
