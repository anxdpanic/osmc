+INT set_cap_dump(RTMP_ADAPTER *pAd, PSTRING arg)
+{
+	ULONG seg = simple_strtol(arg, 0, 10);;
+	CHAR *buf1, *buf2;
+	UINT32 offset = 0;
+	
+	seg = ((seg > 0 && seg <= 4)  ? seg : 1);
+	if (pAd->cap_done == TRUE && (pAd->cap_buf != NULL)) {
+		switch (seg)
+		{
+			case 1:
+				offset = 0;
+				break;
+			case 2:
+				offset = 0x2000;
+				break;
+			case 3:
+				offset = 0x4000;
+				break;
+			case 4:
+				offset = 0x6000;
+				break;
+		}
+		cap_dump(pAd, (pAd->cap_buf + offset), (pAd->cap_buf + 0x8000 + offset), 0x2000);
+	}
+
+	return TRUE;
+}
