+	USHORT RDCount; 	/*Radar detection counter, if RDCount >  ChMovingTime, start to send beacons*/
+	UCHAR RDMode;		/*Radar Detection mode */
+	USHORT ChMovingTime;
+	BOOLEAN bDFSIndoor;
+	ULONG InServiceMonitorCount;	/* unit: sec */
+} DOT11_H, *PDOT11_H;
