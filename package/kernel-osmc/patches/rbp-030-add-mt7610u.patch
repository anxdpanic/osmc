+	CFG80211DBG(RT_DEBUG_ERROR, ("80211> busy time = %ld %ld\n",
+				(ULONG)SurveyInfo.ChannelTimeBusy,
+				(ULONG)SurveyInfo.ChannelTimeExtBusy));
