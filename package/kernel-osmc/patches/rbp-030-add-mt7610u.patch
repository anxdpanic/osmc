+	pSurvey->filled = SURVEY_INFO_CHANNEL_TIME_BUSY |
+						SURVEY_INFO_CHANNEL_TIME_EXT_BUSY;
+	pSurvey->channel_time_busy = SurveyInfo.ChannelTimeBusy; /* unit: us */
+	pSurvey->channel_time_ext_busy = SurveyInfo.ChannelTimeExtBusy;
