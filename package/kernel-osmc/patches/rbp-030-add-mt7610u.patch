+VOID RT_SHA256(
+	IN const UINT8 Message[],
+	IN UINT MessageLen,
+	OUT UINT8 DigestMessage[]);
+#endif /* SHA256_SUPPORT */
+
+
+#endif /* __CRYPT_SHA2_H__ */
