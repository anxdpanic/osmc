+VOID RtmpOsPktBodyCopy(
+	PNET_DEV pNetDev,
+	PNDIS_PACKET pNetPkt,
+	ULONG ThisFrameLen,
+	PUCHAR pData)
+{
+	memcpy(skb_put(pNetPkt, ThisFrameLen), pData, ThisFrameLen);
+	SET_OS_PKT_NETDEV(pNetPkt, pNetDev);
+	RTMP_SET_PACKET_SOURCE(OSPKT_TO_RTPKT(pNetPkt), PKTSRC_NDIS);
+}
