+INT	Show_HtGi_Proc(
+	IN	PRTMP_ADAPTER	pAd, 
+	OUT	PSTRING			pBuf,
+	IN	ULONG			BufLen)
+{
+	switch(pAd->CommonCfg.RegTransmitSetting.field.ShortGI)
