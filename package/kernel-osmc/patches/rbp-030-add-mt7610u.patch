+
+	/*Word2 */
+	UINT32		RSSI0:8;
+	UINT32		RSSI1:8;
+	UINT32		RSSI2:8;
+	UINT32		rsv1:8;
+
+	/*Word3 */
+	UINT32		SNR0:8;
+	UINT32		SNR1:8;
+	UINT32		SNR2:8;
+	UINT32		FOFFSET:8;
+
+	UINT32		rsv3;
+
+}	RXWI_OMAC, *PRXWI_OMAC;
+#endif
+
+
+#define RxWIMPDUByteCnt	RXWI_O.MPDUtotalByteCnt
