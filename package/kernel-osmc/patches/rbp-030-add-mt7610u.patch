+#define CH_BUSY_SAMPLE_POWER 3
+#define CH_BUSY_SAMPLE 		(1 << CH_BUSY_SAMPLE_POWER)
+#define CH_BUSY_MASK  		(CH_BUSY_SAMPLE - 1)
