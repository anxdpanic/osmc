+	UINT32		ShortGI:1;
+	UINT32		BW:1;	/*channel bandwidth 20MHz or 40 MHz */
+	UINT32		MCS:7;
+	
+	UINT32		rsv:1;
+	UINT32		TXRPT:1;
+	UINT32		Autofallback:1; /* TX rate auto fallback disable */
