+Return Value:
+	NDIS_STATUS_SUCCESS or NDIS_STATUS_FAILURE
+
+Note:
+========================================================================
+*/
+INT
+RtmpIoctl_rt_ioctl_siwfrag(
+	IN	RTMP_ADAPTER			*pAd,
+	IN	VOID					*pData,
+	IN	ULONG					Data)
+{
+	pAd->CommonCfg.FragmentThreshold = Data;
+	return NDIS_STATUS_SUCCESS;
+}
