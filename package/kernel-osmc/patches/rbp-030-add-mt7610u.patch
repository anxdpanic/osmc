+#define RxWIBW				RXWI_O.bw
+#define RxWISGI				RXWI_O.sgi
+#define RxWIBSSID			RXWI_O.bss_idx
+#define RxWIPhyMode		RXWI_O.phy_mode
+#define RxWISTBC			RXWI_O.stbc
+#define RxWITID				RXWI_O.tid
