+		NdisMoveMemory(custom+17, ReqVarIEs, ReqVarIELen);
+		RtmpOSWrielessEventSend(pNetDev, RT_WLAN_EVENT_CUSTOM, RT_REQIE_EVENT_FLAG, NULL, (PUCHAR)custom, ReqVarIELen + 17);
