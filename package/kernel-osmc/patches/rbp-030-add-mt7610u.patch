+		if (__pAd->chipOps.EnableAPMIMOPS != NULL)	\
+			__pAd->chipOps.EnableAPMIMOPS(__pAd, __ReduceCorePower);	\
+} while (0)
+
+#define RTMP_CHIP_DISABLE_AP_MIMOPS(__pAd)	\
+do {	\
