+#define RxWIRSSI1			RXWI_O.RSSI1
+#define RxWIRSSI2			RXWI_O.RSSI2
+#define RxWISNR0			RXWI_O.SNR0
+#define RxWISNR1			RXWI_O.SNR1
+#define RxWISNR2			RXWI_O.SNR2
