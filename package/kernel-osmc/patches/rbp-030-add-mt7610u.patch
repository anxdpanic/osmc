+INT pci_kick_out_cmd_msg(
+	PRTMP_ADAPTER ad 
+	struct cmd_msg *msg)
+{
+	NDIS_STATUS Status = NDIS_STATUS_SUCCESS;
+	unsigned long flags = 0;
+	BOOLEAN bIntContext = FALSE;
+	UCHAR QueIdx = QID_AC_VO;
+	ULONG FreeNum;
+	ULONG SwIdx = 0, SrcBufPA;
+	UCHAR *pSrcBufVA;
+	UINT SrcBufLen = 0;
+	PACKET_INFO PacketInfo;
+	TXD_STRUC *pTxD;
+	TXINFO_STRUC *pTxInfo;
+	PNDIS_PACKET pPacket;
+#ifdef RT_BIG_ENDIAN
+	TXD_STRUC *pDestTxD;
+	UCHAR hw_hdr_info[TXD_SIZE];
+#endif
+
+	FreeNum = GET_TXRING_FREENO(ad, QueIdx);
+
+	if (FreeNum == 0)
+		return NDIS_STATUS_FAILURE;
+
+	RTMP_IRQ_LOCK(&ad->irq_lock, flags);
+
+	Status = RTMPAllocateNdisPacket(ad, &pPacket, NULL, 0, Buf+TXINFO_SIZE, Len-TXINFO_SIZE);
+	if (Status != NDIS_STATUS_SUCCESS)
+	{
+		DBGPRINT(RT_DEBUG_WARN, ("PCIKickOutCmd (error:: can't allocate NDIS PACKET)\n"));
+		return NDIS_STATUS_FAILURE;
+	}
+
+	RTMP_QueryPacketInfo(pPacket, &PacketInfo, &pSrcBufVA, &SrcBufLen);
+	if (pSrcBufVA == NULL)
+		return NDIS_STATUS_FAILURE;
+	SwIdx = ad->TxRing[QueIdx].TxCpuIdx;
+#ifdef RT_BIG_ENDIAN
+	pDestTxD  = (PTXD_STRUC)ad->TxRing[QueIdx].Cell[SwIdx].AllocVa;
+	NdisMoveMemory(&hw_hdr_info[0], pDestTxD, TXD_SIZE)
+	pTxD = (TXD_STRUC *)&hw_hdr_info[0];
+	RTMPDescriptorEndianChange((PUCHAR)pTxD, TYPE_TXD);
+#else
+	pTxD  = (PTXD_STRUC)ad->TxRing[QueIdx].Cell[SwIdx].AllocVa;
+#endif
+
+	pTxInfo = (TXINFO_STRUC *)((UCHAR *)pTxD + sizeof(TXD_STRUC));
+	NdisMoveMemory(pTxInfo, Buf, TXINFO_SIZE);
+
+	ad->TxRing[QueIdx].Cell[SwIdx].pNdisPacket = pPacket;
+	ad->TxRing[QueIdx].Cell[SwIdx].pNextNdisPacket = NULL;
+
+	SrcBufPA = PCI_MAP_SINGLE(ad, (pSrcBufVA), (SrcBufLen), 0, RTMP_PCI_DMA_TODEVICE);
+
+	pTxD->LastSec0 = 1;
+	pTxD->LastSec1 = 0;
+	pTxD->SDLen0 = SrcBufLen;
+	pTxD->SDLen1 = 0;
+	pTxD->SDPtr0 = SrcBufPA;
+	pTxD->DMADONE = 0;
+
+#if 0
+	//snowpin test
+	{
+		DBGPRINT(RT_DEBUG_OFF, ("%s():pTxD->SDPtr0=0x%x, SrcBufPtr=0x%p, TxRing=%d, SwIdx=%ld\n", __FUNCTION__,
+								pTxD->SDPtr0, (UCHAR *)(pSrcBufVA), QueIdx, SwIdx));
+
+		hex_dump("MgmtTxDInfo", ad->TxRing[QueIdx].Cell[SwIdx].AllocVa, TXD_SIZE);
+		dump_cmd_txinfo(ad, (TXINFO_STRUC *)(ad->TxRing[QueIdx].Cell[SwIdx].AllocVa + sizeof(TXD_STRUC)));
+		hex_dump("MgmtPktInfo", (pSrcBufVA), pTxD->SDLen0);
+	}
+	//snowpin test
+#endif
+
+#ifdef RT_BIG_ENDIAN
+	RTMPDescriptorEndianChange((PUCHAR)pTxD, TYPE_TXD);
+	WriteBackToDescriptor((PUCHAR)pDestTxD, (PUCHAR)pTxD, FALSE, TYPE_TXD);
+#endif
+
+	ad->RalinkCounters.KickTxCount++;
+	ad->RalinkCounters.OneSecTxDoneCount++;
+
+	/* flush dcache if no consistent memory is supported */
+	RTMP_DCACHE_FLUSH(SrcBufPA, Len);
+	RTMP_DCACHE_FLUSH(ad->TxRing[QueIdx].Cell[SwIdx].AllocPa, TXD_SIZE);
+
+   	/* Increase TX_CTX_IDX, but write to register later.*/
+	INC_RING_INDEX(ad->TxRing[QueIdx].TxCpuIdx, TX_RING_SIZE);
+
+	RTMP_IO_WRITE32(ad, TX_RING_CIDX + QueIdx*0x10, ad->TxRing[QueIdx].TxCpuIdx);
+
+	RTMP_IRQ_UNLOCK(&ad->irq_lock, flags);
+
+	return Status;
+}
