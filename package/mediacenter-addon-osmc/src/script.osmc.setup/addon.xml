<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<addon id="script.osmc.setup" name="OSMC setup" version="0.1.0" provider-name="OSMC">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.osmccommon" version="0.1.0"/>
        <import addon="script.module.osmcsetting.networking" version="0.1.0"/>
    </requires>
    <extension point="xbmc.python.script" library="resources/lib/default.py">
        <provides></provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">OSMC's first-run setup</summary>
        <description lang="en_GB">Sets up a new OSMC device: remote, language and region, network, timezone, device name, SSH, newsletter, warranty and license.</description>
        <language>en</language>
        <platform>linux</platform>
        <license>GPL-2.0-or-later</license>
        <source>https://osmc.tv</source>
        <assets>
            <icon>resources/media/icon.png</icon>
            <fanart>resources/media/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
